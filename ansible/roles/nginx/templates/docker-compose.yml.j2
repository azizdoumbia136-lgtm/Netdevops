services:
  web:
    image: nginx:1.27-alpine
    container_name: web-dmz
    restart: unless-stopped

    ports:
      - "{{ web_ip }}:80:80"
      - "{{ web_ip }}:443:443"

    volumes:
      - ./html:/usr/share/nginx/html:ro
      - ./conf/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./certs:/etc/nginx/certs:ro
